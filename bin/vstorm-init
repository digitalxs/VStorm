#!/usr/bin/env bash
# Copy VStorm project templates (.vscode launch/tasks, .editorconfig) into the current directory.
# Existing files are never overwritten.
set -euo pipefail
T="${XDG_DATA_HOME:-$HOME/.local/share}/vstorm/templates"
[[ -d $T ]] || { echo "Templates not found at $T; run install.sh first." >&2; exit 1; }
mkdir -p .vscode
for f in launch.json tasks.json; do
  [[ -e .vscode/$f ]] && echo "skip   .vscode/$f (exists)" || { cp "$T/$f" ".vscode/$f"; echo "create .vscode/$f"; }
done
for f in .editorconfig requests.http; do
  [[ -e $f ]] && echo "skip   $f (exists)" || { cp "$T/$f" "$f"; echo "create $f"; }
done
